# Variables de entorno de Greek
# Copia este archivo como .env dentro de desktop/.
# Sin claves, Greek funciona en modo local con reglas y herramientas reales.

# OpenCode Zen (opcional). Crea una clave en https://opencode.ai/console
# y usa el id exacto de un modelo de la lista https://opencode.ai/inference/v1/models
OPENCODE_ZEN_API_KEY=
OPENCODE_ZEN_MODEL=
# Endpoint compatible con OpenAI. Por defecto: https://opencode.ai/zen/v1
# OPENCODE_ZEN_BASE=https://opencode.ai/zen/v1

# OpenRouter (opcional, plan gratuito disponible)
OPENROUTER_API_KEY=
# Modelo exacto, por ejemplo un modelo :free vigente en OpenRouter.
GREEK_OPENROUTER_MODEL=

# Ollama (opcional). Greek detecta modelos en 127.0.0.1:11434.
# Si no defines el modelo, usa el primero que encuentre.
GREEK_OLLAMA_MODEL=

# Interfaz de red. Por defecto 127.0.0.1:4319.
# Para conectar el iPhone en la misma Wi-Fi, usa 0.0.0.0:4319.
# GREEK_BIND=0.0.0.0:4319

# Carpeta de datos alternativa (estado, token de respaldo y sandbox).
# GREEK_DATA_DIR=C:\ruta\a\greek-datos
